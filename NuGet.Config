<?xml version="1.0" encoding="utf-8"?>
<!--
  包源与缓存配置。

  当前依赖以 Avalonia 12.1.1 系列为主（Material.Avalonia 3.21.0、
  Avalonia.Controls.WebView 12.1.0），部分包并不随仓库分发，因此默认同时
  启用两个包源：
    - nuget.org：官方在线源，负责下载新增/升级的依赖；
    - local-offline (packages/)：仓库内的小型本地源，保留随仓库分发的包。

  历史说明：本文件最初写在受限沙箱里（当时无法与 api.nuget.org 完成 TLS
  握手，机器级缓存又在可写边界之外），于是 <clear /> 移除了在线源、只留
  packages/。那会导致 Browser/iOS 这类需要 Avalonia.Browser、Avalonia.iOS
  等包的项目报 NU1101。当前在线开发环境已能访问 nuget.org，故恢复在线源。
  若确实需要完全离线还原，可删除 nuget.org 这一行，并把所需 .nupkg 放进
  packages/。

  解包目录固定在仓库 .nuget-packages（见下方 globalPackagesFolder）。
  注意 Directory.Build.props 里还有 RestorePackagesPath（MSBuild 属性，
  优先级高于本文件与环境变量 NUGET_PACKAGES），IDE、CLI、脚本都还原到
  同一目录；若要改变缓存位置，需要同步修改那一处。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-offline" value="packages" />
  </packageSources>
  <config>
    <!-- 解包目录固定在仓库内，避免依赖机器级缓存路径。 -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
</configuration>
