<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniversityTodos.ViewModels"
             xmlns:views="using:UniversityTodos.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="UniversityTodos.Views.TodoListView"
             x:DataType="vm:MainViewModel">

  <!--
    桌面端（DrawerMode=false）的头部/搜索区间距仍保持原值。
    移动端由 MobileTheme.axaml 里的 .mobile-top-app-bar / .mobile-search-region 覆盖。
  -->
  <UserControl.Styles>
    <Style Selector="views|TodoListView[DrawerMode=False] Grid.mobile-top-app-bar">
      <Setter Property="Margin" Value="14,16,14,6" />
    </Style>
    <Style Selector="views|TodoListView[DrawerMode=False] StackPanel.mobile-search-region">
      <Setter Property="Margin" Value="18,0,14,6" />
    </Style>
  </UserControl.Styles>

  <!--
    待办列表（桌面三栏的中栏与移动端全屏列表共用）。
    DrawerMode=true 时（移动端宿主设置）头部按钮切抽屉；否则切宽屏的侧边栏收起。
  -->
  <Border Background="{Binding ListBrush}"
          BorderBrush="{DynamicResource TodoBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 列表头 -->
      <Grid Grid.Row="0" Classes="mobile-top-app-bar"
            ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Classes="tool" Click="OnToggleSidebarClick"
                VerticalAlignment="Top"
                ToolTip.Tip="收起/展开侧边栏">
          <TextBlock Classes="icon" Text="&#xF0C9;" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
          <TextBlock Classes="sectionHeader" Text="{Binding ListTitle}" />
          <TextBlock Classes="faint" Text="{Binding ListSubtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
          <Button Classes="tool" Click="OnAddTodoClick"
                  ToolTip.Tip="新建自建待办">
            <TextBlock Classes="icon" Text="&#xF067;" />
          </Button>
          <Button Classes="tool" Click="OnMarkAllReadClick"
                  IsVisible="{Binding ShowUnreadBadge}"
                  ToolTip.Tip="把公告全部标记为已读（雨课堂只提供「全部已读」接口）">
            <TextBlock Classes="icon" Text="&#xF560;" />
          </Button>
          <Button Classes="tool" Click="OnOpenSourceClick"
                  IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding OpenSourceTooltip}">
            <TextBlock Classes="icon" Text="&#xF35D;" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 提示条 -->
      <StackPanel Grid.Row="1" Classes="mobile-search-region" Spacing="6">
        <!-- 搜索：匹配标题 / 课程 / 备注 / 标签。仅在移动端叠放前置放大镜。 -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="搜索标题、课程、备注、标签…"
                   FontSize="12" MinHeight="30" Padding="8,4" />
          <TextBlock Grid.Column="0" Classes="icon search-leading" Text="&#xF002;"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     IsVisible="{Binding DrawerMode, RelativeSource={RelativeSource AncestorType=views:TodoListView}}" />
          <Button Grid.Column="1" Classes="tool" Click="OnClearSearchClick"
                  IsVisible="{Binding IsSearching}" ToolTip.Tip="清除搜索">
            <TextBlock Classes="icon" Text="&#xF00D;" />
          </Button>
        </Grid>

        <!-- 分组 / 排序：仅计划内与作业视图显示。
             不用 ComboBox：它的下拉 Popup 在离屏审计里会以未约束尺寸参与测量，
             被误判成巨大的 Viewbox/Path；改用按钮 + MenuFlyout，只在点击时才建弹层。 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
              IsVisible="{Binding ShowListLayoutControls}">
          <Button Grid.Column="0" Classes="outline chip" Content="{Binding ListGroupButtonText}"
                  FontSize="12" MinHeight="28" Padding="8,3"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="分组：不分组 / 按来源（雨课堂 / 学习通 / 批改网 / 自建）/ 按课程">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="不分组" Click="OnGroupNoneClick" />
                <MenuItem Header="按来源（雨课堂 / 学习通 / 批改网 / 自建）"
                          Click="OnGroupSourceClick" />
                <MenuItem Header="按课程" Click="OnGroupCourseClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="1" Classes="outline chip" Content="{Binding ListSortButtonText}"
                  FontSize="12" MinHeight="28" Padding="8,3"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="排序：按时间 / 按优先级（平台作业按 3 天内、3–5 天、5–7 天、7 天以上自动划分）">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="按时间" Click="OnSortTimeClick" />
                <MenuItem Header="按优先级" Click="OnSortPriorityClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <!-- 今日课程与水电总览：共享视图 1/4 高度，左右两栏分别滚动。 -->
        <Grid Name="TodayOverviewPanel" ColumnDefinitions="*,*"
              IsVisible="{Binding ShowTodayClasses}">
          <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Text="今日课程" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TodoTextPrimary}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding TodayClasses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClassSessionViewModel">
                    <Grid ColumnDefinitions="52,*" Margin="0,2">
                      <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StartTimeText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TodoAccent}" />
                        <TextBlock Text="{Binding EndTimeText}" FontSize="11"
                                   Foreground="{DynamicResource TodoTextSecondary}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TodoTextPrimary}" />
                        <TextBlock Text="{Binding Location}" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding HasLocation}"
                                   Foreground="{DynamicResource TodoTextSecondary}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Height="1" Background="{DynamicResource TodoBorder}" />
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="4" Margin="12,0,0,0">
            <TextBlock Grid.Row="0" Text="水电总览" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TodoTextPrimary}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="电费" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TodoTextSecondary}" />
                  <TextBlock Text="{Binding Electricity.SelectedRoomOddText, StringFormat='{}{0} 度'}"
                             FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource TodoAccent}" />
                  <TextBlock Text="{Binding Electricity.SelectedRoomOverviewName}"
                             FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource TodoTextSecondary}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="水费 · 本学期" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TodoTextSecondary}" />
                  <TextBlock Text="{Binding Water.TotalFee, StringFormat='{}¥ {0:F2}'}"
                             FontSize="16" FontWeight="SemiBold"
                             IsVisible="{Binding Water.HasData}"
                             Foreground="{DynamicResource TodoAccent}" />
                  <TextBlock Text="待查询" FontSize="16" FontWeight="SemiBold"
                             IsVisible="{Binding !Water.HasData}"
                             Foreground="{DynamicResource TodoAccent}" />
                  <TextBlock Text="{Binding Water.TotalUsage, StringFormat='{}{0:F2} m³'}"
                             FontSize="11" IsVisible="{Binding Water.HasData}"
                             Foreground="{DynamicResource TodoTextSecondary}" />
                  <TextBlock Text="暂无本学期水费" FontSize="11" TextWrapping="Wrap"
                             IsVisible="{Binding !Water.HasData}"
                             Foreground="{DynamicResource TodoTextSecondary}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
        <!-- 数据版本高于程序：只读保护横幅（绝不覆盖新数据） -->
        <Border IsVisible="{Binding IsDataReadOnly}"
                Background="{DynamicResource TodoWarningBackground}"
                BorderBrush="{DynamicResource TodoWarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="数据版本高于当前程序，已进入只读模式" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TodoTextPrimary}" />
            <TextBlock Text="{Binding DataReadOnlyWarning}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TodoTextSecondary}" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding HasWarnings}"
                Background="{DynamicResource TodoWarningBackground}"
                BorderBrush="{DynamicResource TodoWarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="10,8">
          <StackPanel Spacing="2">
            <TextBlock Text="部分数据未能读取" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TodoTextPrimary}" />
            <TextBlock Text="{Binding WarningText}" FontSize="11"
                       Foreground="{DynamicResource TodoTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 登录态失效（保留已缓存的列表，引导去设置页重新登录）。
             用 Grid 的 * / Auto 两列而不是横向 StackPanel：**手机上「去登录」按钮会被挤出屏幕**
             （实测 360dp 宽时按钮右边缘落在 367dp，被列表容器裁掉 7dp，只剩半个按钮）。
             横向 StackPanel 不给子元素换行，超出部分直接画到视口外；
             改成「文字占 * 列、按钮占 Auto 列」后文字先换行，按钮永远留在屏幕内。 -->
        <Border IsVisible="{Binding AuthWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource TodoWarningBackground}"
                BorderBrush="{DynamicResource TodoWarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="10,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Text="{Binding AuthWarning}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TodoTextPrimary}" />
            <Button Grid.Column="1" Classes="outline" Content="去登录" Padding="8,3" FontSize="11"
                    VerticalAlignment="Center" Click="OnGoLoginClick" />
          </Grid>
        </Border>

        <CheckBox Classes="todo" Content="隐藏已勾选" FontSize="11"
                  Foreground="{DynamicResource TodoTextSecondary}"
                  IsChecked="{Binding List.HideLocallyDone}"
                  IsVisible="{Binding ShowHideDoneToggle}" />
      </StackPanel>

      <!-- 列表。空列表时整块折叠，否则「隐藏已勾选」的复选框会以未初始化状态
           渲染在空状态文案旁边，看起来像个孤立的对勾。 -->
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding List.HasItems}">
        <ItemsControl ItemsSource="{Binding List.VisibleItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoItemViewModel">
              <StackPanel>
                <!-- 分组标题贴在每组第一条上方：不额外制造一行，勾选/选中仍只面对真实条目 -->
                <Border IsVisible="{Binding IsGroupStart}" Margin="14,10,14,3">
                  <TextBlock Classes="groupHeader" Text="{Binding GroupLabel}" />
                </Border>

                <Border Classes="row"
                        Classes.selected="{Binding IsSelected}"
                        Classes.serverdone="{Binding IsCompletedOnServer}"
                        Classes.localdone="{Binding IsDone}"
                        Tapped="OnRowTapped">
                  <Grid ColumnDefinitions="Auto,*,Auto">
  
                    <!-- 圆形勾选（本地） -->
                    <CheckBox Grid.Column="0" Classes="todocircle"
                              IsChecked="{Binding IsDone, Mode=OneWay}"
                              Click="OnCheckboxClick"
                              VerticalAlignment="Top" Margin="0,1,0,0"
                              ToolTip.Tip="在应用内标记（不改变雨课堂的完成状态）" />
  
                    <!-- 主体：主标题学科名、副标题作业/考试标题（学期前缀已剥离） -->
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="3">
                      <TextBlock Classes="title" Text="{Binding HeaderPrimary}" />
  
                      <!-- 副标题行：Grid 的 * 列让标题按实际宽度截断（显式 Width=200
                           在手机上会盖住右侧徽标），完成状态跟在标题后。 -->
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="faint" Text="{Binding HeaderSecondary}" />
                        <TextBlock Grid.Column="1" Classes="overdue" Text="{Binding StatusText}"
                                   Margin="6,0,0,0"
                                   IsVisible="{Binding IsCompletedOnServer}" />
                      </Grid>
  
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="meta" Text="{Binding DueText}" />
                        <!-- 雨课堂已判定完成的作业不该再显示「已过期」：
                             剩余时间只对未完成的事项有意义。 -->
                        <TextBlock Classes="faint" Text="·"
                                   IsVisible="{Binding ShowRemaining}" />
                        <TextBlock Classes="meta" Text="{Binding RemainingText}"
                                   IsVisible="{Binding ShowRemainingNotOverdue}" />
                        <TextBlock Classes="overdue" Text="{Binding RemainingText}"
                                   IsVisible="{Binding ShowRemainingOverdue}" />
                      </StackPanel>
                    </StackPanel>
  
                    <!-- 右侧徽标：进度 / 已过期 / 真实完成状态 -->
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                      <Button Classes="tool" IsVisible="{Binding IsStarred}" Click="OnStarClick"
                              Padding="2" ToolTip.Tip="取消星标">
                        <TextBlock Text="&#xF005;" FontSize="13"
                                   Foreground="{DynamicResource TodoWarningBorder}" />
                      </Button>
                      <Border Classes="badge" Classes.warn="{Binding IsHighPriority}"
                              IsVisible="{Binding ShowPriorityBadge}"
                              ToolTip.Tip="平台作业按剩余时间自动划分：3 天内 / 3–5 天 / 5–7 天 / 7 天以上">
                        <TextBlock Text="{Binding PriorityText}" />
                      </Border>
                      <Border Classes="badge progress" IsVisible="{Binding ShowProgress}">
                        <TextBlock Text="{Binding ProgressText}" />
                      </Border>
                      <Border Classes="badge warn"
                              IsVisible="{Binding IsOverdue}">
                        <TextBlock Text="已过期" />
                      </Border>
                      <Border Classes="badge"
                              IsVisible="{Binding IsCompletedOnServer}">
                        <TextBlock Text="雨课堂已完成" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!--
        课程视图：学习通每门课的未完成任务点汇总。
        与待办列表是两条独立通道（课程行没有勾选/截止时间/进度），
        由 List.ShowCourseList 决定渲染哪一条。
      -->
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding List.ShowCourseList}">
        <ItemsControl ItemsSource="{Binding List.Courses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChaoxingCourseViewModel">
              <Border Classes="row"
                      Classes.selected="{Binding IsSelected}"
                      Tapped="OnCourseTapped">
                <Grid ColumnDefinitions="*,Auto">

                  <StackPanel Grid.Column="0" Margin="2,0,8,0" Spacing="3">
                    <TextBlock Classes="title" Text="{Binding CourseName}" />
                    <TextBlock Classes="faint" Text="{Binding SummaryText}" />
                    <TextBlock Classes="meta" Text="{Binding ClazzText}"
                               IsVisible="{Binding HasClazzText}" />
                  </StackPanel>

                  <!-- 右侧：未完成任务点徽标 -->
                  <Border Grid.Column="1" Classes="badge progress"
                          IsVisible="{Binding HasPending}"
                          VerticalAlignment="Top">
                    <TextBlock Text="{Binding PendingText}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 空状态：移动端显示圆形图标 + 标题 + 可换行说明；桌面端只保留说明文字。 -->
      <StackPanel Grid.Row="2" Classes="empty-state"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24"
                  IsVisible="{Binding ShowEmptyState}">
        <Border Classes="empty-icon"
                IsVisible="{Binding DrawerMode, RelativeSource={RelativeSource AncestorType=views:TodoListView}}">
          <TextBlock Classes="icon" Text="&#xF0AE;" />
        </Border>
        <TextBlock Classes="empty-title" Text="暂无内容"
                   IsVisible="{Binding DrawerMode, RelativeSource={RelativeSource AncestorType=views:TodoListView}}" />
        <TextBlock Classes="faint empty-message"
                   Text="{Binding List.EmptyMessage}" />
      </StackPanel>

      <!-- 忙碌条 -->
      <Border Grid.Row="3" IsVisible="{Binding IsBusy}"
              Background="{DynamicResource TodoAccentSoft}" Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" Text="&#xF021;" FontSize="13"
                     Foreground="{DynamicResource TodoAccent}" />
          <TextBlock Text="{Binding SyncStatus}" FontSize="12"
                     Foreground="{DynamicResource TodoAccent}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
