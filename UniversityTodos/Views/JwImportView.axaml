<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniversityTodos.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="UniversityTodos.Views.JwImportView"
             x:DataType="vm:MainViewModel"
             Background="{Binding SurfaceBrush}">

  <!--
    教务课表与考试信息共用的控制面板。真正的教务网页在独立 NativeWebDialog 中。
    课表保留悬浮球与手动抓取；考试模式进入查询页后自动读取，手动按钮用于重试。
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="26,20,26,0">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="{Binding JwImportTitle}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TodoTextPrimary}" />
        <TextBlock Text="{Binding JwImportDescription}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TodoTextSecondary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="outline" Content="重新打开教务窗口" Padding="10,5" FontSize="12"
                Click="OnReopenWindowClick" />
        <Button Classes="primary" Content="{Binding JwReturnButtonText}" Padding="10,5" FontSize="12"
                Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- 状态：抓取结果与错误原因（悬浮球文案只够一句话，这里给完整说明） -->
    <Border Grid.Row="1" Margin="26,12,26,0" Padding="12,10" CornerRadius="4"
            Background="{DynamicResource TodoAccentSoft}"
            IsVisible="{Binding TimetableStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding TimetableStatus}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TodoTextPrimary}" />
    </Border>

    <!-- 中间：操作指引 -->
    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"
                MaxWidth="520">
      <TextBlock Classes="icon" Text="&#xF0AC;" FontSize="34"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource TodoTextTertiary}" />
      <TextBlock FontSize="13" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                 Foreground="{DynamicResource TodoTextSecondary}"
                 Text="{Binding JwImportGuide}" />
      <Button Classes="primary" Content="{Binding JwFetchButtonText}" Padding="16,9" FontSize="13"
              HorizontalAlignment="Center"
              Click="OnManualFetchClick"
              IsEnabled="{Binding !ExamInfo.IsLoading}" />
      <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource TodoTextTertiary}"
                 Text="手动登录教务系统后读取当前数据，不保存或自动提交教务账密，不修改远端数据。" />
    </StackPanel>

    <!-- 底部：窗口状态 -->
    <TextBlock Grid.Row="3" Margin="26,0,26,16" FontSize="11"
               Foreground="{DynamicResource TodoTextTertiary}"
               Text="{Binding JwWindowStateText}" />
  </Grid>
</UserControl>
