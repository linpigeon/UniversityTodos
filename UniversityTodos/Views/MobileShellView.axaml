<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniversityTodos.ViewModels"
             xmlns:views="using:UniversityTodos.Views"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="760"
             x:Class="UniversityTodos.Views.MobileShellView"
             x:DataType="vm:MainViewModel">

  <!--
    Android 外壳：移动布局 = 内容区 + 四项底部导航（待办 / 课表 / 电费 / 设置）。
    列表、课表与设置占第 0 行；底部导航占第 1 行并持续可见（抽屉打开时除外）。
    详情 / 答题 / 登录 / 教务导入等整页覆盖层以及抽屉仍用 Grid.RowSpan=2 盖住底栏；
    课表和设置不再盖住底栏，只占用内容区。
    抽屉仍是覆盖式（遮罩 + 不透明面板）；点选事项进全屏详情二级页。
    与桌面外壳（TodoShellView）共用同一 MainViewModel 与全部内容部件
    （SidebarView / TodoListView / TodoDetailView），只在外壳组合方式上不同。

    **为什么这个文件在共享项目而不是 Android 头**：
    它原先在 UniversityTodos.Android/Views 下，导致「渲染手机尺寸」的界面遮挡审计
    （androidcheck，跑在桌面头）根本编译不到它——只能看共享项目里的其它视图，
    而移动端特有的层叠顺序、返回栏、抽屉恰恰是最容易出遮挡的地方。
    唯一挡路的是 NavigateExamWeb 里那一句 Android 的 CookieManager，
    已抽成 IPlatformServices.PrepareExamWebSession（默认空实现）。
    现在两端编译的是同一份外壳代码，审计的就是线上跑的那个。
  -->
  <Grid RowDefinitions="*,Auto">

    <!-- 列表底下的不透明层：TodoListView 的 ListBrush 带 alpha（壁纸透明度），
         没有这层时 Android 壁纸会透上来，正文对比度不足。 -->
    <Border Grid.Row="0" Background="{DynamicResource TodoDialogBackground}" />

    <!-- 全屏待办列表（DrawerMode=true：头部按钮切抽屉） -->
    <views:TodoListView Name="MobileTodoList" Grid.Row="0" DrawerMode="True"
                        IsVisible="{Binding ShowTodoPane}" />

    <!-- 底部导航：四项等宽（待办 / 课表 / 电费 / 设置），复用 MainViewModel 的
         NavItems / SelectedNav / OpenSettings，不新增业务导航状态。
         “待办”统一映射到 key=all，“课表/电费/设置”保持原覆盖层逻辑；
         选中态由 MobileShellView.axaml.cs 同步。抽屉打开时整条收起。 -->
    <Border Grid.Row="1" Name="MobileNavBar" Classes="mobile-nav"
            IsVisible="{Binding !DrawerOpen}">
      <Grid ColumnDefinitions="*,*,*,*">

        <Button Grid.Column="0" Name="TodoNavButton" Classes="mobile-nav"
                Classes.selected="True" Tag="todo" Click="OnMobileNavClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="mobile-nav-pill">
              <TextBlock Classes="icon" Text="&#xF03A;" />
            </Border>
            <TextBlock Text="待办" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Name="TimetableNavButton" Classes="mobile-nav"
                Tag="timetable" Click="OnMobileNavClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="mobile-nav-pill">
              <TextBlock Classes="icon" Text="&#xF133;" />
            </Border>
            <TextBlock Text="课表" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Name="ElectricityNavButton" Classes="mobile-nav"
                Tag="electricity" Click="OnMobileNavClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="mobile-nav-pill">
              <TextBlock Classes="icon" Text="&#xF0E7;" />
            </Border>
            <TextBlock Text="电费" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Name="SettingsNavButton" Classes="mobile-nav"
                Tag="settings" Click="OnMobileNavClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="mobile-nav-pill">
              <TextBlock Classes="icon" Text="&#xF013;" />
            </Border>
            <TextBlock Text="设置" />
          </StackPanel>
        </Button>

      </Grid>
    </Border>

    <!--
      课表页：只占内容区第 0 行，底部导航保持可见。
      移动端 CompactMode 已是七列同屏，不再需要横向滑动看周末；
      桌面端仍走 TimetableView 的默认宽度与布局。
      自带移动头部（返回/导入/周次），所以这里不再叠一层返回栏。
      宿主只在首次打开时创建 TimetableView，关闭后保留实例复用；
      启动时不为不可见课表创建控件、执行文字排版。
    -->
    <ContentControl Name="TimetableContentHost" Grid.Row="0"
                    IsVisible="{Binding TimetableOpen}" />

    <ContentControl Name="ElectricityContentHost" Grid.Row="0"
                    IsVisible="{Binding ElectricityOpen}" />

    <Border Grid.RowSpan="2" Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding ExamInfoOpen}">
      <views:ExamInfoView />
    </Border>

    <!-- 教务导入页：覆盖课表与底部导航。控制面板用不透明底；
         真正的教务网页由 JwImportView 在独立 NativeWebDialog 中打开。 -->
    <Border Grid.RowSpan="2" Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding JwImportOpen}">
      <views:JwImportView />
    </Border>

    <!-- 详情二级页：选中事项后全屏覆盖，左上角返回。
         背景必须不透明：SurfaceBrush 为壁纸效果带透明度，浮层会透出列表。 -->
    <Border Grid.RowSpan="2"
            Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="tool" Click="OnDetailBackClick"
                Margin="10,10,0,0" HorizontalAlignment="Left"
                ToolTip.Tip="返回列表">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xF060;" />
            <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TodoTextSecondary}" />
          </StackPanel>
        </Button>
        <views:TodoDetailView Grid.Row="1" />
      </Grid>
    </Border>

    <!-- 设置页占内容区，底部导航保持可见；左上角仍可返回列表。 -->
    <Border Grid.Row="0"
            Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding SettingsOpen}">
      <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="tool" Click="OnSettingsBackClick"
                Margin="10,10,0,0" HorizontalAlignment="Left"
                ToolTip.Tip="返回列表">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xF060;" />
            <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TodoTextSecondary}" />
          </StackPanel>
        </Button>
        <views:SettingsView Grid.Row="1" CompactMode="True" />
      </Grid>
    </Border>

    <!-- 应用内答题页（移动版考试 H5，WebView 全局 cookie 自带登录态），左上角返回 -->
    <Border Grid.RowSpan="2"
            Background="{DynamicResource TodoDialogBackground}"
            IsVisible="{Binding ExamWebUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="tool" Click="OnExamWebBackClick"
                Margin="10,10,0,0" HorizontalAlignment="Left"
                ToolTip.Tip="返回详情">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xF060;" />
            <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TodoTextSecondary}" />
          </StackPanel>
        </Button>
        <Panel Name="ExamWebHost" Grid.Row="1" />
      </Grid>
    </Border>

    <!-- 登录覆盖层（雨课堂 / 学习通，从设置页「账号」进入；启动不再弹登录） -->
    <Border Grid.RowSpan="2"
            Background="Transparent"
            IsVisible="{Binding LoginHostVisible}"
            IsHitTestVisible="True">
      <Border.RenderTransform>
        <TranslateTransform X="{Binding LoginOverlayOffsetX}" />
      </Border.RenderTransform>
      <Grid>
        <Border Background="{DynamicResource TodoDialogBackground}"
                IsVisible="{Binding !LoginBackgroundRequested}" />
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="tool" Click="OnLoginBackClick"
                  Margin="10,10,0,0" HorizontalAlignment="Left"
                  IsVisible="{Binding !LoginBackgroundRequested}"
                  ToolTip.Tip="返回设置">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xF060;" />
              <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource TodoTextSecondary}" />
            </StackPanel>
          </Button>
          <ContentControl Name="LoginContentHost" Grid.Row="1" />
        </Grid>
      </Grid>
    </Border>

    <!-- 抽屉遮罩（点遮罩收起） -->
    <Border Grid.RowSpan="2" Background="#66000000"
            IsVisible="{Binding DrawerOpen}"
            PointerPressed="OnDrawerScrimPressed" />

    <!-- 覆盖式抽屉（不透明底，侧边栏画刷带透明度，叠底后不透出列表） -->
    <Border Name="DrawerPanel" Grid.RowSpan="2" IsVisible="{Binding DrawerOpen}"
            HorizontalAlignment="Left" Width="300"
            Background="{DynamicResource TodoDialogBackground}"
            BoxShadow="4 0 24 0 #40000000">
      <views:SidebarView />
    </Border>

    <!-- Android 新建待办：与桌面窗口共享 TodoEditorForm，全屏显示并盖住底栏。 -->
    <Border Name="ManualEditorOverlay" Grid.RowSpan="2" IsVisible="False"
            Background="{DynamicResource TodoDialogBackground}" />
  </Grid>
</UserControl>
